# Multiplayer game with view system
add_executable(sky_combat_multiplayer
    src/sky_combat_multiplayer.c
    src/models/aircraft.c
    src/models/aircraft_responsive.c
    src/models/weapons.c
    src/models/aircraft_manager.c
    src/models/match_rules.c
    src/models/powerups.c
    src/models/cyberpunk_world.c
    src/views/camera_controller.c
    src/controllers/input_mvc_fast.c
    src/controllers/input_controller_fast.c
    src/models/input_model_fast.c
)
target_link_libraries(sky_combat_multiplayer raylib m)
target_include_directories(sky_combat_multiplayer PRIVATE include)

# Multiplayer Incremental - step by step from original
add_executable(sky_combat_multiplayer_incremental
    src/controllers/sky_combat_multiplayer_incremental.c
    src/models/input_model_fast.c
    src/models/aircraft_responsive.c
    src/models/aircraft_manager.c
    src/models/powerups.c
    src/models/overdrive.c
    src/models/boss_cyber_dragon.c
    src/views/combat_effects.c
    src/controllers/input_controller_fast.c
    src/controllers/input_mvc_fast.c
    src/controllers/input_astro_direct.c
)
target_link_libraries(sky_combat_multiplayer_incremental sky_combat)

# Main game executable - FULL NODE: Firewall Fly-over
add_executable(full-node-firewall-flyover
    full_node_firewall_flyover.c
)
target_link_libraries(full-node-firewall-flyover sky_combat)
set_target_properties(full-node-firewall-flyover PROPERTIES
    OUTPUT_NAME "full-node-firewall-flyover"
)

# Apply ALL safety verifications
if(ENABLE_GDB_PROOF)
    REQUIRE_LOCKED_CONTROLS(full-node-firewall-flyover)
endif()

# Install
install(TARGETS sky_combat DESTINATION lib)
install(DIRECTORY include/sky_combat DESTINATION include)
install(TARGETS full-node-firewall-flyover DESTINATION bin)
install(TARGETS sky_combat_ultimate DESTINATION bin)
install(TARGETS sky_combat_5player DESTINATION bin)
install(TARGETS sky_combat_multiplayer DESTINATION bin)
install(TARGETS sky_combat_multiplayer_incremental DESTINATION bin)

# Control test program
add_executable(test_controls_direct
    test_controls_direct.c
    src/models/input_model_fast.c
    src/controllers/input_controller_fast.c
    src/controllers/input_mvc_fast.c
)
