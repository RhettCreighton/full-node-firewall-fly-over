target_include_directories(test_controls_direct PRIVATE include)

# Multiplayer Ultimate - combines best of both
add_executable(sky_combat_multiplayer_ultimate
    src/sky_combat_multiplayer_ultimate.c
    src/models/aircraft.c
    src/models/aircraft_responsive.c
    src/models/weapons.c
    src/models/aircraft_manager.c
    src/models/match_rules.c
    src/models/powerups.c
    src/models/cyberpunk_world.c
    src/views/combat_effects.c
    src/controllers/input_mvc_fast.c
    src/controllers/input_controller_fast.c
    src/models/input_model_fast.c
)
target_link_libraries(sky_combat_multiplayer_ultimate raylib m)
target_include_directories(sky_combat_multiplayer_ultimate PRIVATE include)

# Test program for GDB proof system
if(ENABLE_GDB_PROOF)
    add_executable(test_gdb_proof test_gdb_proof.c)
    target_link_libraries(test_gdb_proof m)
    target_include_directories(test_gdb_proof PRIVATE include)
    
    # Include the GDB proof module
    set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${CMAKE_CURRENT_SOURCE_DIR}/modules/compile_time_gdb_proof/cmake")
    include(GDBProof)
    
    # This will make the build FAIL if safety functions aren't called!
    REQUIRE_NO_COREDUMP_GUARANTEE(test_gdb_proof)
    
    # Bad example - this should FAIL verification
    add_executable(test_gdb_proof_bad test_gdb_proof_bad.c)
    target_link_libraries(test_gdb_proof_bad m)
    target_include_directories(test_gdb_proof_bad PRIVATE include)
    REQUIRE_NO_COREDUMP_GUARANTEE(test_gdb_proof_bad)
    
    # Control lock test
    add_executable(test_control_lock test_control_lock.c)
    target_link_libraries(test_control_lock m)
    target_include_directories(test_control_lock PRIVATE include)
    REQUIRE_LOCKED_CONTROLS(test_control_lock)
    
    # Plane view demo
    add_executable(plane_view_demo plane_view_demo.c)
    target_link_libraries(plane_view_demo raylib m)
    target_include_directories(plane_view_demo PRIVATE include)
    REQUIRE_VIEW_BEHAVIOR(plane_view_demo)
endif()

