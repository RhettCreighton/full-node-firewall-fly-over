cmake_minimum_required(VERSION 3.10)
project(full-node-firewall-flyover C)

set(CMAKE_C_STANDARD 99)
set(CMAKE_C_STANDARD_REQUIRED ON)

# Add module paths
list(APPEND CMAKE_MODULE_PATH 
    "${CMAKE_CURRENT_SOURCE_DIR}/modules/compile_time_gdb_proof"
    "${CMAKE_CURRENT_SOURCE_DIR}/robust_build_system/cmake"
)

# Include compile-time GDB proof system
option(ENABLE_GDB_PROOF "Enable compile-time GDB verification" ON)
if(ENABLE_GDB_PROOF)
    add_subdirectory(modules/compile_time_gdb_proof)
    include(${CMAKE_CURRENT_SOURCE_DIR}/modules/compile_time_gdb_proof/cmake/GDBProof.cmake OPTIONAL)
endif()

# Add safety flags to catch errors (but not as errors for now)
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wextra -Wno-unused-parameter")
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -g")



# Find raylib
find_package(PkgConfig REQUIRED)
pkg_check_modules(RAYLIB REQUIRED raylib)

# Create library
add_library(sky_combat STATIC
    # Models
    src/models/aircraft.c
    src/models/course.c
    src/models/weapons.c
    src/models/ai_pilot.c
    src/models/input_model.c
    src/models/enemies.c
    src/models/cyberpunk_world.c
    
    # Views
    src/views/hud.c
    src/views/input_view.c
    src/views/combat_effects.c
    
    # Controllers
    src/controllers/sky_combat.c
    src/controllers/input.c
    src/controllers/input_controller.c
)

target_include_directories(sky_combat PUBLIC 
    ${CMAKE_CURRENT_SOURCE_DIR}/include
    ${RAYLIB_INCLUDE_DIRS}
)

target_link_libraries(sky_combat PUBLIC
    ${RAYLIB_LIBRARIES}
    m
)

target_compile_options(sky_combat PUBLIC ${RAYLIB_CFLAGS_OTHER})
target_link_directories(sky_combat PUBLIC ${RAYLIB_LIBRARY_DIRS})


# DISABLED - Using unified binary instead
# add_executable(sky_combat_ultimate
    # Main controller
    src/controllers/sky_combat_ultimate.c
    
    # Models
    src/models/input_model_fast.c
    src/models/aircraft_responsive.c
    src/models/overdrive.c
    src/models/boss_cyber_dragon.c
    
    # Controllers
    src/controllers/input_controller_fast.c
    src/controllers/input_mvc_fast.c
    src/controllers/input_astro_direct.c
)
target_link_libraries(sky_combat_ultimate sky_combat)

# Apply control lock verification if GDB proof is enabled
if(ENABLE_GDB_PROOF)
    REQUIRE_LOCKED_CONTROLS(sky_combat_ultimate)
endif()




# 5 Player version
add_executable(sky_combat_5player
    src/controllers/sky_combat_ultimate_5player.c
    src/models/aircraft_manager.c
    src/models/aircraft_responsive.c
    src/models/overdrive.c
    src/models/powerups.c
    src/controllers/input_controller_fast.c
    src/controllers/input_mvc_fast.c
    src/models/input_model_fast.c
)
target_link_libraries(sky_combat_5player sky_combat)

# Apply control lock verification if GDB proof is enabled
if(ENABLE_GDB_PROOF)
    REQUIRE_LOCKED_CONTROLS(sky_combat_5player)
endif()

