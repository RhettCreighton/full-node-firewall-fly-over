{
  "description": "Prove joystick handling code paths are correct",
  "source": "src/secure_joystick_demo.c",
  "tests": [
    {
      "name": "prove_null_handled",
      "enabled_paths": ["NULL_INPUT", "INVALID_AXIS", "RIGHT_STICK_Y_CORRECT", "OTHER_AXIS"],
      "disabled_paths": ["RIGHT_STICK_Y_WRONG"],
      "inputs": [
        {"TEST_SCENARIO": "null_input"}
      ],
      "implies": "Null joystick events are safely handled"
    },
    {
      "name": "prove_correct_axis_5",
      "enabled_paths": ["NULL_INPUT", "INVALID_AXIS", "RIGHT_STICK_Y_CORRECT", "OTHER_AXIS"],
      "disabled_paths": ["RIGHT_STICK_Y_WRONG"],
      "inputs": [
        {"TEST_SCENARIO": "correct_axis"}
      ],
      "implies": "Axis 5 is correctly used for right stick Y"
    },
    {
      "name": "prove_axis_3_unreachable",
      "enabled_paths": ["NULL_INPUT", "INVALID_AXIS", "RIGHT_STICK_Y_CORRECT", "OTHER_AXIS"],
      "disabled_paths": ["RIGHT_STICK_Y_WRONG"],
      "inputs": [
        {"TEST_SCENARIO": "wrong_axis"}
      ],
      "implies": "Axis 3 path is unreachable - build should fail or hit OTHER_AXIS"
    },
    {
      "name": "prove_bounds_checking",
      "enabled_paths": ["NULL_INPUT", "INVALID_AXIS", "RIGHT_STICK_Y_CORRECT", "OTHER_AXIS"],
      "disabled_paths": ["RIGHT_STICK_Y_WRONG"],
      "inputs": [
        {"TEST_SCENARIO": "invalid_axis"}
      ],
      "implies": "Out of bounds axes are caught"
    },
    {
      "name": "prove_array_safety",
      "enabled_paths": ["NULL_ARRAY", "EMPTY_ARRAY", "ARRAY_ACCESS_SAFE"],
      "disabled_paths": [],
      "inputs": [
        {"TEST_SCENARIO": "array_null"},
        {"TEST_SCENARIO": "array_safe"}
      ],
      "implies": "Array access is always safe"
    },
    {
      "name": "prove_no_divide_by_zero",
      "enabled_paths": ["DIVIDE_BY_ZERO", "DIVIDE_OVERFLOW", "DIVIDE_SUCCESS"],
      "disabled_paths": [],
      "inputs": [
        {"TEST_SCENARIO": "divide_zero"},
        {"TEST_SCENARIO": "divide_safe"}
      ],
      "implies": "Division by zero is handled safely"
    },
    {
      "name": "prove_all_nondeterministic",
      "enabled_paths": ["NULL_INPUT", "INVALID_AXIS", "RIGHT_STICK_Y_CORRECT", "OTHER_AXIS", "NULL_ARRAY", "EMPTY_ARRAY", "ARRAY_ACCESS_SAFE", "DIVIDE_BY_ZERO", "DIVIDE_SUCCESS", "UNKNOWN_SCENARIO"],
      "disabled_paths": ["RIGHT_STICK_Y_WRONG", "DIVIDE_OVERFLOW"],
      "inputs": [
        {"TEST_SCENARIO": "null_input"},
        {"TEST_SCENARIO": "correct_axis"},
        {"TEST_SCENARIO": "invalid_axis"},
        {"TEST_SCENARIO": "array_null"},
        {"TEST_SCENARIO": "array_safe"},
        {"TEST_SCENARIO": "divide_zero"},
        {"TEST_SCENARIO": "divide_safe"},
        {"TEST_SCENARIO": "unknown_test"}
      ],
      "implies": "All possible nondeterministic inputs are safe - axis 3 and overflow paths proven unreachable"
    }
  ]
}